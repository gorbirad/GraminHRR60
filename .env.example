# Szablon pliku z sekretami / danymi logowania.
# Skopiuj ten plik jako ".env" i uzupełnij prawdziwymi danymi.
# Plik ".env" jest w .gitignore i NIGDY nie trafi do repozytorium.

# --- Garmin Connect ---
GARMIN_EMAIL=twoj_email@example.com
GARMIN_PASSWORD=twoje_haslo

# Folder, w którym garminconnect/garth zapisze token sesji po zalogowaniu,
# żeby nie logować się przy każdym uruchomieniu programu.
GARMIN_TOKEN_STORE=./data/.garth_session

# --- Discord (opcjonalnie, na później) ---
# ID kanału i token bota - wypełnić dopiero gdy dodamy integrację z Discordem.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Baza danych ---
DATABASE_PATH=./data/hrr.db
